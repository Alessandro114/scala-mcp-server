  "pricing": {
    "type": "freemium",
    "free_tier": "14-day trial on Growth plan",
    "paid_plans_url": "https://get-scala.com/#pricing"
  },
  "installation": {
    "command": "npx -y scala-mcp-server",
    "env": {
      "SCALA_API_KEY": "Your API key from https://app.get-scala.com"
    }
  }
