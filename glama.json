  "tools": [
    { "name": "search_companies", "description": "Search 250M+ companies by name, VAT, keyword" },
    { "name": "lookup_company", "description": "Get full company profile by ID or VAT" },
    { "name": "company_report", "description": "Generate financial health report" },
    { "name": "database_stats", "description": "Database statistics" },
    { "name": "list_countries", "description": "List countries with company counts" },
    { "name": "check_credits", "description": "Check API credits and plan" },
    { "name": "crm_list_contacts", "description": "List and search CRM contacts" },
    { "name": "crm_create_contact", "description": "Create a CRM contact" },
    { "name": "crm_update_contact", "description": "Update a CRM contact" },
    { "name": "crm_pipeline", "description": "View sales pipeline" },
    { "name": "crm_contact_timeline", "description": "Contact activity timeline" },
    { "name": "booking_get_slots", "description": "Get available booking slots" },
    { "name": "booking_create", "description": "Create a booking" },
    { "name": "booking_cancel", "description": "Cancel a booking" },
    { "name": "invoice_list", "description": "List invoices" },
    { "name": "invoice_create", "description": "Create an invoice" },
    { "name": "invoice_send", "description": "Send invoice by email" },
    { "name": "invoice_get_pdf", "description": "Get invoice PDF" },
    { "name": "sara_chat", "description": "Chat with SARA AI assistant" },
    { "name": "sara_conversations", "description": "List SARA conversations" },
    { "name": "sara_insights", "description": "AI business insights" },
    { "name": "sara_alerts", "description": "Business alerts" },
    { "name": "sara_proactive", "description": "Proactive AI suggestions" },
    { "name": "finance_summary", "description": "Financial overview" },
    { "name": "finance_health_score", "description": "Business health score" },
    { "name": "finance_cash_flow", "description": "Cash flow analysis" },
    { "name": "vertical_kpis", "description": "Vertical-specific KPIs (20 industries)" },
    { "name": "vertical_list_data", "description": "List records from any vertical" },
    { "name": "vertical_create_record", "description": "Create record in any vertical" },
    { "name": "vertical_access", "description": "Check active vertical modules" },
    { "name": "workflow_list", "description": "List automation workflows" },
    { "name": "workflow_run", "description": "Execute a workflow" },
    { "name": "workflow_stats", "description": "Workflow statistics" }
