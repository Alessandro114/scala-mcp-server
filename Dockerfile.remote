# Server MCP remoto (Streamable HTTP). Build: docker build -f Dockerfile.remote -t scala-mcp-remote .
# Il Dockerfile storico (stdio, usato da Smithery) resta invariato.
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY src/ src/
RUN npx tsc

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production MCP_REMOTE=1 HOST=0.0.0.0 PORT=3030
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist dist/
USER node
EXPOSE 3030
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3030)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "dist/remote.js"]
